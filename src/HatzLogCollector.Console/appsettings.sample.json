{
  "Collector": {
    "HatzBaseUrl": "https://ai.hatz.ai/v1/",
    "InitialLookbackDays": 30,
    "WindowHours": 24,
    "OverlapMinutes": 15,
    "PageSize": 200,
    "MaxParallelDetailRequests": 4,
    "Sources": [
      {
        "Name": "msp",
        "ApiKeyRef": "HATZ_KEY_MSP",
        "DiscoverTenants": true,
        "ExcludeTenantIds": []
      },
      {
        "Name": "example-client",
        "ApiKeyRef": "HATZ_KEY_EXAMPLE_CLIENT",
        "TenantIds": [ "tenant_REPLACE_ME" ]
      }
    ]
  },
  "Storage": {
    "Mode": "Local",
    "LocalRoot": "./archive",
    "AccountUrl": "https://REPLACE_ME.blob.core.windows.net",
    "ConnectionStringEnv": ""
  },
  "Pii": {
    "LanguageEndpoint": "https://REPLACE_ME.cognitiveservices.azure.com/",
    "LanguageKeyEnv": "",
    "Language": "en",
    "MinConfidence": 0.8,
    "IncludeToolOutput": true,
    "MaxCharsPerSession": 250000,
    "MaxParallelRequests": 4
  }
}
